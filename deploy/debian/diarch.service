[Unit]
Description=Diarch ebook library
After=network.target

[Service]
Type=simple
User=diarch
Group=diarch
# Ensure rmapi (reMarkable send) is findable; auth tokens live under data dir.
Environment=PATH=/usr/local/bin:/usr/bin
Environment=HOME=/var/lib/diarch
Environment=RMAPI_CONFIG=/var/lib/diarch/.rmapi
Environment=DIARCH_LISTEN=0.0.0.0:8083
Environment=DIARCH_DATA_DIR=/var/lib/diarch
# Secrets / integrations (chmod 600, root-owned):
EnvironmentFile=/etc/diarch.env
ExecStart=/usr/local/bin/diarch
Restart=on-failure
RestartSec=3
Nice=5
# Optional CPU soft limit for background friendliness
CPUQuota=50%

# Create user once: sudo useradd --system --home /var/lib/diarch --shell /usr/sbin/nologin diarch
# sudo mkdir -p /var/lib/diarch/{library,imports,queue/needs_tts,queue/incoming_audio}
# sudo chown -R diarch:diarch /var/lib/diarch
# Apt + rmapi + auth: see deploy/debian/README.md dependency checklist

[Install]
WantedBy=multi-user.target
