# Copy to .env (gitignored) and fill in. Loaded automatically on server start.
# Existing shell/export env vars override these.

# Audible activation bytes for AAX → M4B (never commit the real value).
# Get via audible-cli / inaudible-activator for your account; not stored in audible2m4b.
DIARCH_AUDIBLE_KEY=

# Optional Google Books API key (avoids unauthenticated daily quota / 429).
# Strongly recommended for recent / indie / self-pub titles (e.g. 979-* ISBNs):
# Open Library and Library of Congress often lag months or never index them;
# Google Books is usually the only catalog that has a hit, but needs a key.
# Create at https://console.cloud.google.com/apis/library/books.googleapis.com
# DIARCH_GOOGLE_BOOKS_KEY=

# StoryGraph pull + metadata enrich (unofficial scrape).
# Prefer Integrations → StoryGraph in the UI (writes data/storygraph.conf).
# Paste the full Cookie header from DevTools (remember_user_token + usually cf_clearance).
# Optional user_agent: line in storygraph.conf must match the browser that minted cf_clearance.
# Env still works as bootstrap / override fallback when no file exists.
# DIARCH_STORYGRAPH_USER=your_sg_username
# DIARCH_STORYGRAPH_COOKIE=remember_user_token=…; cf_clearance=…

# reMarkable send requires `rmapi` on PATH (https://github.com/ddvk/rmapi).
# On Keystone: install binary to /usr/local/bin and auth as the diarch user
# (see deploy/debian/README.md). DIARCH_REMARKABLE_TOKEN is unused for uploads.
# DIARCH_REMARKABLE_TOKEN=

# LocalAI (Phase 8) — covers + audiobook transcription.
# DIARCH_LOCALAI_URL=http://192.168.0.104:30286
# DIARCH_LOCALAI_IMAGE_MODEL=flux.2-klein-4b
# DIARCH_LOCALAI_IMAGE_SIZE=512x512
# DIARCH_LOCALAI_TRANSCRIBE_MODEL=nemo-parakeet-tdt-0.6b
# Optional Hermes agent shim for covers (falls back to LocalAI images API).
# DIARCH_HERMES_URL=

# DIARCH_ADMIN_USER=admin
# Fresh DB only: bootstrap admin password (min 12 chars; not "admin").
# Once the admin user exists, DIARCH_ADMIN_PASS is ignored — existing password is never overwritten.
# To rotate: set a strong DIARCH_ADMIN_PASS and DIARCH_ADMIN_PASS_FORCE=1, then restart once.
# DIARCH_ADMIN_PASS=change-me-now
# DIARCH_ADMIN_PASS_FORCE=
# DIARCH_DATA_DIR=./data
# DIARCH_LISTEN=0.0.0.0:8083
# Set when serving behind HTTPS (marks session cookie Secure).
# DIARCH_COOKIE_SECURE=1
# Only if a reverse proxy sets X-Forwarded-For and you trust it (login rate limit).
# DIARCH_TRUST_PROXY=1
