# Copy to .env (gitignored) and fill in. Loaded automatically on server start.
# Existing shell/export env vars override these.

# Audible activation bytes for AAX → M4B (never commit the real value).
# Get via audible-cli / inaudible-activator for your account; not stored in audible2m4b.
DIARCH_AUDIBLE_KEY=

# Optional Google Books API key (avoids unauthenticated daily quota / 429).
# Create at https://console.cloud.google.com/apis/library/books.googleapis.com
# DIARCH_GOOGLE_BOOKS_KEY=

# DIARCH_ADMIN_USER=admin
# DIARCH_ADMIN_PASS=admin
# DIARCH_DATA_DIR=./data
# DIARCH_LISTEN=0.0.0.0:8083
